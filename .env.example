# Copy to ~/.config/vault_watcher/env (loaded by the app and by the systemd
# EnvironmentFile). Never commit real secrets. systemd does not expand ~, so use
# absolute paths. chmod 600 the deployed file since it holds the API key.

# --- Required ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Working directories (defaults shown; raw/archive/failed must stay OUTSIDE
#     the Titan vault so raw inputs are never indexed) ---
VAULT_WATCHER_RAW_DIR=/home/<your-user>/0_Pipeline/In
VAULT_WATCHER_PROCESSED_DIR=/home/<your-user>/0_Pipeline/Out
VAULT_WATCHER_ARCHIVE_DIR=/home/<your-user>/0_Pipeline/Archive
VAULT_WATCHER_FAILED_DIR=/home/<your-user>/0_Pipeline/Failed

# --- Classification + extraction tuning ---
# Seed list of existing Titan domains; Gemini may still invent a new one.
VAULT_WATCHER_DOMAINS=business,lernen,projekte,system
# Max characters of extracted text sent to Gemini (longer is truncated + logged).
VAULT_WATCHER_MAX_CHARS=200000

# --- Titan integration: point the processed dir inside the vault, e.g. ---
# VAULT_WATCHER_PROCESSED_DIR=/mnt/f/vault/notes/inbox
