[Unit]
Description=Obsidian Vault Inbox Watcher (Package-based Service)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/charl/projects/obsidian-inbox-watcher
EnvironmentFile=/home/charl/.config/vault_watcher/env
ExecStart=/home/charl/projects/obsidian-inbox-watcher/.venv/bin/obsidian-inbox-watcher
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
